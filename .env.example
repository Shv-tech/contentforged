# =============================================================================
# Forge environment
#
# Copy to .env.local for development. Variables marked REQUIRED must be set
# for the app to start; everything else switches a feature on, and the app
# says plainly when a feature is off rather than faking it.
# =============================================================================

# --- App ---------------------------------------------------------------------
# REQUIRED. Public origin, no trailing slash. OAuth redirect URIs, email links
# and share pages are built from it, so it must match exactly in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (REQUIRED) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects call this the publishable key; older ones the anon key.
# Either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the calendar-event database webhook.
SUPABASE_WEBHOOK_SECRET=

# --- Models (REQUIRED: Anthropic) ---------------------------------------------
ANTHROPIC_API_KEY=
# Fallback provider used when Anthropic is unavailable, and speech to text
# (Whisper) for voice notes and interviews.
GROQ_API_KEY=
# Embeddings for episodic memory (RAG), and the transcription fallback when
# Groq is not set or fails.
OPENAI_API_KEY=

# --- Secrets at rest (REQUIRED for publishing) --------------------------------
# 32 random bytes, base64. Encrypts LinkedIn, Threads and Bluesky credentials.
# Generate with: openssl rand -base64 32
# Rotating it invalidates stored connections (users reconnect).
FORGE_ENCRYPTION_KEY=

# --- Scheduled jobs (REQUIRED for results, auto-publish, digests) -------------
# Sent by Supabase pg_cron as "Authorization: Bearer <CRON_SECRET>". Jobs
# refuse to run without it. See the end of
# supabase/migrations/20261025000000_forge_intelligence.sql.
CRON_SECRET=

# --- X (profile audit, voice import, niche pulse, Reply Radar, results) ---------
# App-only bearer token from the X developer portal (pay-per-use).
X_BEARER_TOKEN=
# Daily ceiling on public, no-login audits across all visitors.
FORGE_PUBLIC_AUDITS_PER_DAY=400

# --- Web research (War Room, fact-checked drafts) ----------------------------
TAVILY_API_KEY=

# --- LinkedIn publishing -----------------------------------------------------
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/connections/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Add r_member_postAnalytics once LinkedIn approves it to read
# results automatically.
LINKEDIN_SCOPES=openid profile w_member_social
# Optional. YYYYMM of the versioned REST API.
LINKEDIN_API_VERSION=202606

# --- Threads publishing ------------------------------------------------------
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/connections/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# Bluesky needs no server configuration: users connect with an app password.

# --- Rate limiting -----------------------------------------------------------
# Without Upstash, public limits are per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_MARKETING=Forge <news@forgeyourway.dev>
EMAIL_REPLY_TO=hello@forgeyourway.dev

# --- Email-in capture (Resend inbound) ----------------------------------------
# The domain people forward mail to, e.g. in.forgeyourway.dev, set up for
# receiving in Resend. Each brand gets a private address on it.
FORGE_INBOUND_DOMAIN=
# Signing secret of the Resend webhook for "email.received", pointed at
# <NEXT_PUBLIC_APP_URL>/api/capture/email. Inbound mail is refused without it.
RESEND_INBOUND_WEBHOOK_SECRET=

# --- Push notifications (Web Push) -------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto: or https: URL.
VAPID_SUBJECT=mailto:hello@forgeyourway.dev

# --- Internal ----------------------------------------------------------------
# Comma-separated addresses that can open /admin (usage from product events)
# and /admin/ops (health and errors). They also get monitoring alert emails.
ADMIN_EMAILS=

# --- Monitoring (/admin/ops) --------------------------------------------------
# All optional. Needs supabase/migrations/20261126000000_forge_ops.sql and the
# forge-ops-health job scheduled every 5 minutes.
# Share of successful requests to store, 0 to 1 (errors are always stored).
# Lower it at high traffic, for example 0.2; counts are scaled back up.
OPS_SAMPLE_SUCCESS=1
# Days to keep normal rows. Errors are kept at least 90 days.
OPS_RETENTION_DAYS=14
# Email ADMIN_EMAILS when this many server errors happen within 10 minutes.
OPS_ALERT_ERRORS=10
# Set to 1 to switch all recording off.
OPS_DISABLED=

# --- Billing (Razorpay) ------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids, created by scripts/setup-razorpay-plans.ts
RAZORPAY_PLAN_STARTER_INR=
RAZORPAY_PLAN_STARTER_USD=
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_PRO_USD=
RAZORPAY_PLAN_AGENCY_INR=
RAZORPAY_PLAN_AGENCY_USD=

# --- Development only --------------------------------------------------------
# Unlocks every plan-gated tool in the UI and on the server. Never in production.
NEXT_PUBLIC_UNLOCK_ALL_TOOLS=false
# Optional ads on free tool pages.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
